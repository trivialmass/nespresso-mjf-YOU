# HTTP Basic Auth — protects the entire site
AuthType Basic
AuthName "Nespresso × MJF"
AuthUserFile /home/clients/78a49d666a169f61d6089d73db1a7ae2/sites/nespresso-mjf.trivialmass.com/.htpasswd
Require valid-user

# ── Block .git directory ──────────────────────────────────────────────────────
<DirectoryMatch "\.git">
    Require all denied
</DirectoryMatch>

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none';"
</IfModule>

# ── Rate limiting on PHP API (requires mod_evasive or mod_ratelimit) ──────────
<IfModule mod_ratelimit.c>
    <Location /php-backend/api/save-result.php>
        SetOutputFilter RATE_LIMIT
        SetEnv rate-limit 400
    </Location>
</IfModule>

# Route /api/* to the PHP backend only — no SPA fallback needed (no React Router)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass through real files and directories (e.g. /assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Serve SPA for all 6 invitation paths
    RewriteRule ^invitation_[zot]_july_[89]$ index.html [L]

    # Route /api/* to the PHP backend
    RewriteRule ^api/(.*)$ php-backend/api/$1.php [L]

    # Fallback: all other paths served by the SPA (e.g. /admin)
    RewriteRule ^ index.html [L]
</IfModule>

# Explicit MIME types — prevents browser rejecting JS modules
<IfModule mod_mime.c>
    AddType application/javascript   .js .mjs
    AddType text/css                 .css
    AddType image/webp               .webp
    AddType image/svg+xml            .svg
    AddType application/json         .json
    AddType font/woff2               .woff2
    AddType font/woff                .woff
</IfModule>

# PHP files are executed server-side — source/credentials are never exposed to clients.
# The save-result.php endpoint already rejects non-POST requests (405).

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/css              "access plus 1 week"
</IfModule>
